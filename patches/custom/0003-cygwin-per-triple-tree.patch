+void Cygwin::AddClangCXXStdlibIncludeArgs(const ArgList &DriverArgs,
+                                           ArgStringList &CC1Args) const {
+  ToolChain::AddClangCXXStdlibIncludeArgs(DriverArgs, CC1Args);
+
+  // libc++ headers live in the per-triple tree
+  // (<sysroot>/<triple>/include/c++/v1), not in <sysroot>/usr/include/c++/v1
+  // where CC1's default header search expects them.
+  if (DriverArgs.hasArg(options::OPT_nostdincxx) ||
+      GetCXXStdlibType(DriverArgs) != ToolChain::CST_Libcxx)
+    return;
+
+  const std::string SysRoot = computeSysRoot();
+  const std::string TripleNames[] = {getTriple().getArchName().str() + "-pc-cygwin",
+                                     getTriple().str()};
+  for (const std::string &Name : TripleNames) {
+    const std::string Dir = SysRoot + "/" + Name + "/include/c++/v1";
+    if (getDriver().getVFS().exists(Dir))
+      addSystemInclude(DriverArgs, CC1Args, Dir);
+  }
+}
